linters: all_linters(
    packages = "lintr",
    implicit_integer_linter = NULL,
    undesirable_function_linter = NULL,
    function_argument_linter = NULL,
    indentation_linter = NULL,
    object_name_linter = NULL,
    # object_usage_linter stays off, see #710. Enabling it reported 13
    # lints, of which one was real. The rest are cli glue strings,
    # `case_when()` formulas and tidyverse NSE that codetools cannot
    # see, plus test fixtures that `setup.R` binds at the top level.
    # It also needs the package installed to resolve imports, so a
    # local `lint_package()` reports hundreds of spurious lints.
    object_usage_linter = NULL,
    namespace_linter = NULL,
    missing_package_linter = NULL,
    return_linter(return_style = "explicit"),
    cyclocomp_linter = NULL
  )
exclusions: list(
    "inst",
    "tests/testthat.R" = list(
      unused_import_linter = Inf
    ),
    "vignettes/faq.Rmd" = list(
      library_call_linter = Inf
    ),
    "vignettes/chunks/_readme-install-epidist.Rmd" = list(
      nonportable_path_linter = Inf
    )
  )
