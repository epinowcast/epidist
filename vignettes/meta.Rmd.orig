```{r setup, include=FALSE}
# exclude compile warnings from cmdstanr
knitr::opts_chunk$set(
  fig.path = file.path("figures", "meta-"),
  collapse = TRUE,
  comment = "#>",
  message = TRUE,
  warning = FALSE,
  error = FALSE
