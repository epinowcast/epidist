# Code copied from citation()
author <- meta$`Authors@R`
if (length(author)) {
    aar <- .read_authors_at_R_field(author)
    author <- Filter(function(e) {
        !(is.null(e$given) && is.null(e$family)) && !is.na(match("aut",
            e$role))
    }, aar)
}

# DESCRIPTION has no Date field, so take the year CRAN stamps on release and
# fall back to the current year for a development install.
year <- sub("-.*", "", meta$`Date/Publication`)
if (!length(year) || !nzchar(year)) {
  year <- format(Sys.Date(), "%Y")
}

bibentry(
  bibtype = "Manual",
  title   = paste0(meta$Package, ": ", gsub("[[:space:]]+", " ", meta$Title)),
  author  = author,
  year    = year,
  doi     = "10.5281/zenodo.14213017"
)
